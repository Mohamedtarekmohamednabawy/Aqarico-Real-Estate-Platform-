    "terms": {
        "termsTitle": "شروط الخدمة",
        "privacyTitle": "سياسة الخصوصية",
        "agreementTitle": "اتفاقية المستخدم",
        "t1Title": "قبول الشروط",
        "t1Body": "باستخدامك لعقاريكو، فأنت تؤكد أنك قرأت وفهمت ووافقت على هذه الشروط. إذا كنت لا توافق، يُرجى التوقف عن استخدام المنصة. قد نحدّث هذه الشروط من وقت لآخر — ويُعدّ استمرارك في الاستخدام بعد أي تغييرات قبولاً منك لها.",
        "t2Title": "مسؤوليات المستخدم",
        "t2Body": "أنت وحدك المسؤول عن دقة واكتمال أي إعلان أو معلومة تنشرها، بما في ذلك تفاصيل العقار والسعر والصور ومعلومات التواصل. يُحظر تقديم محتوى مضلل أو احتيالي ويؤدي إلى تعليق الحساب أو إنهائه.",
        "t3Title": "السلوك المحظور",
        "t3Body": "لا يجوز استخدام عقاريكو لنشر إعلانات مكررة أو مزيفة أو عشوائية. كما لا يجوز نسخ محتوى المنصة أو إعادة توزيعه دون إذن كتابي. أي محاولة للتلاعب بالإعلانات أو نتائج البحث أو المستخدمين تُعدّ انتهاكاً لهذه الشروط.",
        "t4Title": "إشراف المحتوى",
        "t4Body": "تحتفظ عقاريكو بالحق في مراجعة أو تعديل أو إزالة أي إعلان ينتهك هذه الشروط، بما في ذلك التفاصيل الكاذبة أو الصور المسيئة أو الأسعار المضللة، وقد يتم ذلك دون إشعار مسبق.",
        "t5Title": "المعاملات والمسؤولية",
        "t5Body": "عقاريكو منصة وسيطة فحسب. جميع المفاوضات والاتفاقيات والمعاملات تتم مباشرة بين المشترين والبائعين والوكلاء. لسنا طرفاً في أي صفقة عقارية ولا نتحمل أي مسؤولية عن نتيجة أي معاملة أو نزاع أو خسارة مالية.",
        "t6Title": "إنهاء الحساب",
        "t6Body": "نحتفظ بالحق في تعليق أو إنهاء أي حساب ينتهك هذه الشروط أو يمارس سلوكاً مسيئاً أو يشكّل خطراً على المستخدمين الآخرين، مع إشعار مسبق أو دونه حسب الخطورة.",
        "p1Title": "ما الذي نجمعه",
        "p1Body": "عند تسجيلك أو استخدامك لعقاريكو، نجمع المعلومات التي تقدمها مباشرة كالاسم والبريد الإلكتروني ورقم الهاتف وإعلانات العقارات. كما نجمع بيانات الاستخدام الأساسية لتحسين تجربة المنصة.",
        "p2Title": "كيف نستخدم بياناتك",
        "p2Body": "تُستخدم معلوماتك لتشغيل حسابك وعرض إعلاناتك وتقديم توصيات عقارية مناسبة. لا نبيع بياناتك الشخصية لأطراف ثالثة. قد نشارك بيانات محدودة مع مزودي الخدمة لتقديم ميزات المنصة فقط.",
        "p3Title": "ملفات تعريف الارتباط والتخزين المحلي",
        "p3Body": "تستخدم عقاريكو التخزين في المتصفح لتذكر جلستك وتفضيلاتك وإعدادات الفلاتر. يمكنك مسح هذه البيانات في أي وقت من إعدادات متصفحك.",
        "p4Title": "أمان البيانات",
        "p4Body": "نتخذ تدابير تقنية وتنظيمية معقولة لحماية بياناتك من الوصول غير المصرح به أو الضياع أو إساءة الاستخدام. يتم تشفير كلمات المرور ولا تُخزّن كنص عادي. نشجعك على استخدام كلمة مرور قوية وفريدة.",
        "p5Title": "حقوقك",
        "p5Body": "يمكنك الوصول إلى حسابك وتعديله أو حذفه وجميع بياناته المرتبطة في أي وقت عبر صفحة الإعدادات. إذا أردت إزالة بياناتك نهائياً من خوادمنا، أرسل طلب حذف وسنعالجه خلال 14 يوماً.",
        "p6Title": "التواصل",
        "p6Body": "لأي مخاوف تتعلق بالخصوصية أو طلبات البيانات، تواصل معنا مباشرة عبر المنصة. نأخذ هذه المسائل بجدية ونرد في أقرب وقت.",
        "a1Title": "الاستخدام الأمين للمنصة",
        "a1Body": "باستخدامك لعقاريكو، تلتزم بنشر العقارات التي تملك حق إدراجها فقط، مع تفاصيل دقيقة وصور حقيقية وأسعار صادقة. ولا يجوز انتحال صفة وكلاء أو مستخدمين آخرين أو تزوير هويتك.",
        "a2Title": "الامتثال القانوني",
        "a2Body": "توافق على الامتثال لجميع قوانين العقارات المصرية واللوائح المحلية المعمول بها عند الإدراج أو التعامل على المنصة. لا تتحقق عقاريكو من الوضع القانوني لأي عقار مدرج ولا تتحمل مسؤولية أي إخفاق في الامتثال.",
        "a3Title": "الملكية الفكرية",
        "a3Body": "أي محتوى تحمّله — صور أو أوصاف أو مستندات — يظل ملكاً لك. بنشره على عقاريكو، تمنحنا ترخيصاً غير حصري وبدون مقابل لعرضه وتخزينه وتوزيعه داخل المنصة. لن نستخدم محتواك في إعلانات خارج عقاريكو دون موافقتك.",
        "a4Title": "تسوية النزاعات",
        "a4Body": "أي نزاعات بين المستخدمين تتعلق بإعلان أو صفقة تُعالج مباشرة بين الأطراف المعنية. قد تساعد عقاريكو في التحقيق بالمخالفات الجسيمة المبلغ عنها، لكننا لسنا هيئة تحكيم وقراراتنا غير ملزمة قانونياً.",
        "a5Title": "التغييرات على هذه الاتفاقية",
        "a5Body": "قد نراجع هذه الاتفاقية مع تطور المنصة. عند ذلك، سنحدّث التاريخ في أعلى هذه الصفحة. سيتم إبلاغك بالتغييرات الجوهرية عبر البريد الإلكتروني أو إشعار داخل التطبيق. استمرارك في استخدام عقاريكو بعد ذلك يعني قبولك للاتفاقية المعدّلة."
